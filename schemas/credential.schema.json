{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Master-of-Agents/Hermes-ACC/schemas/credential.schema.json",
  "title": "CredentialRegistry",
  "description": "Schema for credentials/credential-registry.yaml",
  "type": "object",
  "required": ["schema_version", "credentials"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "provider", "purpose", "storage_location", "owner", "status"],
        "properties": {
          "name":                  { "type": "string" },
          "provider":              { "type": "string" },
          "purpose":               { "type": "string" },
          "required_by":           { "type": "object" },
          "storage_location":      { "type": "string" },
          "encrypted_secret_ref":  { "type": ["string", "null"] },
          "runtime_destination":   { "type": "string" },
          "rotation_frequency_days": { "type": "integer" },
          "last_rotated":          { "type": "string" },
          "recovery_notes":        { "type": "string" },
          "owner":                 { "type": "string" },
          "blast_radius":          { "type": "string" },
          "dependencies":          { "type": "array" },
          "revocation_procedure":  { "type": "string" },
          "status":                { "type": "string", "enum": ["active", "rotated", "revoked", "planned"] }
        },
        "additionalProperties": true
      }
    }
  }
}
