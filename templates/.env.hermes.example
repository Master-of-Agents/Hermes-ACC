# Hermes runtime environment — EXAMPLE / TEMPLATE
# Do NOT fill in real values here. This file is committed as a reference.
# Real values live in secrets/hermes.env.enc.yaml (sops-encrypted).
# Generate the real runtime file with: bash scripts/render-env-from-sops.sh /run/hermes/.env

# Telegram gateway
# Registry entry: credentials/credential-registry.yaml → TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Telegram home channel (config value, not secret)
TELEGRAM_HOME_CHAT_ID=8615165545

# LLM routing via OpenRouter
# Registry entry: credentials/credential-registry.yaml → OPENROUTER_API_KEY
OPENROUTER_API_KEY=REPLACE_ME

# Direct Anthropic API (used by some Hermes profiles)
# Registry entry: credentials/credential-registry.yaml → ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=REPLACE_ME

# Hermes runtime paths (usually set inside the container image defaults)
HERMES_HOME=/opt/data
HERMES_PROJECT=/opt/hermes
